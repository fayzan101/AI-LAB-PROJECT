# Standard local run: uvicorn on port **8000** (see repo root PORTS.md).
# Example: uvicorn main:app --reload --host 127.0.0.1 --port 8000

# Portal backend must point here (server-to-server):
# AI_SERVER_BASE_URL=http://localhost:8000

SERVICE_CLIENT_ID=portal-backend
SERVICE_CLIENT_SECRET=change-me

# CORS: portal web app (Next.js) on **3000**
CORS_ORIGINS=http://localhost:3000
