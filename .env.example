# Standard local run: uvicorn on port **8000** (see repo root PORTS.md).
# Example: uvicorn main:app --reload --host 127.0.0.1 --port 8000

# Portal backend must point here (server-to-server):
# AI_SERVER_BASE_URL=http://localhost:8000
# AI_SERVICE_CLIENT_ID / AI_SERVICE_CLIENT_SECRET must match the values below.

APP_NAME=AI Employee Analytics System
ENV=development
API_PREFIX=/api/v1

JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=remote-work-ai-server
JWT_AUDIENCE=remote-work-portal
TOKEN_EXP_SECONDS=3600

SERVICE_CLIENT_ID=portal-backend
SERVICE_CLIENT_SECRET=change-me

DATABASE_URL=sqlite:///employee_analytics.db

# CORS: portal web app (Next.js) on **3000**
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# REDIS_URL=redis://localhost:6379

# Optional classical ML
# AI_ML_ENABLED=false
# AI_ML_MODEL_PATH=
# AI_ML_MODEL_VERSION=none
